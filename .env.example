# Copy to .env and fill in values. See CLAUDE.md for which vars are required per phase.

# Phase 1 — Foundation + Watchlist Seeding
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
STEAM_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
RAWG_API_KEY=

# Phase 2 — Sentiment worker
# Reddit collection is unauthenticated (no OAuth vars needed).
YOUTUBE_API_KEY=

# Phase 3 — Patch notes worker (optional)
# JSON object mapping a watchlist game's exact games.title to one or more
# developer-blog/official patch-page URLs, e.g. {"Fortnite": ["https://www.fortnite.com/news/rss"]}
GAME_PATCH_PAGES=

# Phase 4 — Observability (optional; no-op if unset)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Phase 4 — Briefing email delivery (optional; no-op if either is unset)
RESEND_API_KEY=
BRIEFING_EMAIL_TO=
BRIEFING_EMAIL_FROM=

# Later phases — Portfolio Manager + Alpaca execution
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=
