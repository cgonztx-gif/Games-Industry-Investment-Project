# Copy to .env and fill in values. See CLAUDE.md for which vars are required per phase.

# Phase 1 — Foundation + Watchlist Seeding
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
STEAM_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
RAWG_API_KEY=

# Phase 2 — Sentiment worker
# Reddit collection defaults to unauthenticated public .json endpoints (no vars
# needed) via agents/workers/sentiment/reddit_source.py. Two optional alternate-
# egress paths exist for when the default path is IP-blocked by Reddit's WAF
# (confirmed a persistent block from datacenter IPs as of 2026-07-06) -- both are
# no-ops until their vars are set, and build_reddit_source() tries them in this
# order before falling back to the unauthenticated path:
#   1. OAuth (all three required together, or none are used):
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
#   2. Standard HTTP/HTTPS proxy (SOCKS5 not supported):
REDDIT_PROXY_URL=
# Deliberately paused 2026-07-09 (set to "true") -- skips Reddit entirely (zero
# network calls, both sentiment and discovery workers degrade the same way they
# already do on a block) until a real OAuth/proxy egress path is set up. Unset
# or set to "false" to resume.
REDDIT_SOURCE_PAUSED=true
YOUTUBE_API_KEY=

# Phase 3 — Patch notes worker (optional)
# JSON object mapping a watchlist game's exact games.title to one or more
# developer-blog/official patch-page URLs, e.g. {"Fortnite": ["https://www.fortnite.com/news/rss"]}
GAME_PATCH_PAGES=

# Phase 4 — Observability (optional; no-op if unset)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Phase 4 — Briefing email delivery (optional; no-op if either is unset)
RESEND_API_KEY=
BRIEFING_EMAIL_TO=
BRIEFING_EMAIL_FROM=

# Later phases — Portfolio Manager + Alpaca execution
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=
