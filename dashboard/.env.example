# Same Supabase project the Python pipeline writes to.
NEXT_PUBLIC_SUPABASE_URL=
# anon/public key -- Supabase dashboard -> Settings -> API. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Same value as the Python backend's SUPABASE_URL/SUPABASE_KEY.
# Never prefix these with NEXT_PUBLIC_ -- see src/lib/supabase/server.ts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
